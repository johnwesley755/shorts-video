# Environment Configuration for Shorts Video AI

# Optional: Free API key from https://enter.pollinations.ai
# Bypasses anonymous IP rate limits and provides high-speed priority generation
POLLINATIONS_API_KEY=

# Server Configuration
PORT=5000
DEBUG=True
API_URL=http://localhost:5000/api

# AI Model Configuration
INFERENCE_MODE=auto  # 'auto', 'serverless', 'local'
IMAGE_MODEL=stabilityai/sd-turbo
TTS_MODEL=facebook/fastspeech2-en-ljspeech
